# Database
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=aftersales_db
DATABASE_URL="mysql://root:@127.0.0.1:3306/aftersales_db"

# Auth. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The app falls back to an insecure default if this is unset, so it must be set in production.
JWT_SECRET=

# Outgoing mail (Gmail app password, used for password-reset OTPs)
SMTP_EMAIL=
SMTP_PASSWORD=

# Public origin, used to build links in emails and QR codes
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web push. Generate a pair with: npx web-push generate-vapid-keys
# The same pair must be used everywhere the app runs: regenerating invalidates
# every existing subscription and devices go silent until they re-subscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com
